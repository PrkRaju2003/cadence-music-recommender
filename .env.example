# Copy to .env to use the dedicated Supabase project. Both values are publishable.
# Never put a service-role key or database password here or in browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Set to 1 on HTTPS hosts behind a trusted reverse proxy.
COOKIE_SECURE=0
